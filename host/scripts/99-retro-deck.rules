# Retro Deck - Raspberry Pi Pico running CircuitPython
# Matches the specific board by serial so other Picos aren't affected.
# Grants the `tty` group rw access and creates a stable /dev/retrodeck symlink.
#
# Install:
#   sudo install -m 0644 99-retro-deck.rules /etc/udev/rules.d/99-retro-deck.rules
#   sudo udevadm control --reload-rules
#   sudo udevadm trigger --subsystem-match=tty
#
# ID_USB_INTERFACE_NUM=="02" pins the symlink to the CDC *data* interface. The
# board exposes two CDC ports sharing this serial — 00 (console/REPL) and 02
# (data). Without the interface match the rule fires for both and /dev/retrodeck
# lands on whichever enumerated last, often the console port (no protocol data).
SUBSYSTEM=="tty", ATTRS{idVendor}=="239a", ATTRS{idProduct}=="80f4", ATTRS{serial}=="E6616407E35B1E28", ENV{ID_USB_INTERFACE_NUM}=="02", GROUP="tty", MODE="0660", SYMLINK+="retrodeck"
